#!/usr/bin/env node
// Watches app/assets/stylesheets and app/javascript for changes and rebuilds CSS.
// Needed because tailwindcss v3's --watch mode exits immediately on some Linux setups.

const { execSync } = require('child_process')
const fs = require('fs')
const path = require('path')

const CMD = './node_modules/.bin/tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify'
const WATCH_DIRS = ['app/assets/stylesheets', 'app/javascript']

let rebuilding = false
let pending = false

function build() {
  if (rebuilding) { pending = true; return }
  rebuilding = true
  try {
    execSync(CMD, { stdio: 'inherit' })
  } catch (_) {}
  rebuilding = false
  if (pending) { pending = false; build() }
}

build()

WATCH_DIRS.forEach(dir => {
  if (!fs.existsSync(dir)) return
  fs.watch(dir, { recursive: true }, (_event, filename) => {
    if (filename && /\.(css|jsx?|tsx?)$/.test(filename)) build()
  })
})

process.stdin.resume()
